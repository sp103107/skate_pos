    "DISPOSED": []
  },
  "guards": [
    {
      "transition": "AVAILABLE->RENTED",
      "requires": [
        "complete_pair",
        "no_blocking_maintenance",
        "no_active_rental",
        "no_reservation_conflict"
      ]
    },
    {
      "transition": "*->AVAILABLE",
      "requires": [
        "complete_pair",
        "no_blocking_maintenance",
        "lifecycle_active_or_transferred"
      ]
    },
    {
      "transition": "*->RETIRED",
      "requires": [
        "owner_admin_authorization"
      ]
    }
  ]
